# Vision LLM Provider API Keys
# Provide at least one API key to perform bill extractions

# Google Gemini API Key (Recommended: gemini-2.0-flash / gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Alternative: llama-3.2-11b-vision-preview)
GROQ_API_KEY=your_groq_api_key_here

# Selected extraction provider: "gemini" or "groq" (defaults to "gemini" if GEMINI_API_KEY is present)
EXTRACTION_PROVIDER=gemini
